Subject: Make the UniFFI binding-generator CLI opt-in

The OpenWrt package builds only libprotun. Avoid enabling CLI generator
dependencies in its normal library graph. Keep the existing generator
available through the explicit bindgen-cli feature.

--- a/Cargo.toml
+++ b/Cargo.toml
@@ -21,7 +21,7 @@
 pvpnclient = { version = "~4.0.0", registry = "proton" }
 rustls-pki-types = { version = "1.14", optional = true, default-features = false }
 socket2 = { version = "0.6.5", optional = true }
-uniffi = { version = "0.31.0", features = ["cli"], optional = true } # 0.31.0 is the highest uniffi version supported for C#: https://github.com/NordSecurity/uniffi-bindgen-cs
+uniffi = { version = "0.31.0", optional = true } # 0.31.0 is the highest uniffi version supported for C#: https://github.com/NordSecurity/uniffi-bindgen-cs
 rand = "0.10"
 serde = { version = "1.0", features = ["derive"], optional = true }
 serde_json = { version = "1.0", optional = true  }
@@ -69,6 +69,7 @@
 protun = { path = ".", features = ["test_utils"] }
 
 [features]
+bindgen-cli = ["uniffi", "uniffi/cli"]
 default = ["unix", "local-agent"]
 unix = ["dep:libc", "dep:socket2", "mio", "uniffi"]
 android = ["unix"]
@@ -86,7 +87,7 @@
 [[bin]]
 name = "uniffi-bindgen"
 path = "uniffi-bindgen.rs"
-required-features = ["uniffi"]
+required-features = ["bindgen-cli"]
 
 [[example]]
 name = "sample"
